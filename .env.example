# DeployX Environment Variables Example
# Copy this file to .env.local and fill in your actual values.
# Do NOT commit .env.local to version control.

# Database Configuration (MongoDB Atlas)
MONGODB_URI=
MONGODB_DB=deployx_db

# Authentication Session Secret
JWT_SECRET=

# GitHub OAuth Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional callback override (defaults to ${NEXT_PUBLIC_APP_URL}/api/integrations/github/callback)
GITHUB_CALLBACK_URL=
# Optional 256-bit encryption key (defaults to cryptographically derived from JWT_SECRET)
ENCRYPTION_KEY=

# Cloudflare Pages Integration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
