# ==============================================================================
# DeployX Production & Local Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' for local development.
# 2. In production hosting (Vercel, Railway, Render, etc.), configure these keys
#    directly in your platform's encrypted Environment Variables dashboard.
# 3. NEVER commit '.env.local' or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Canonical URL (Public Client / Server)
# ------------------------------------------------------------------------------
# Set to 'production' on live deployments, 'development' locally
NODE_ENV=development

# The public canonical URL of the DeployX control panel (NO trailing slash)
# Production: https://deployx.yourdomain.com
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration — MongoDB Atlas (Private Server-Only)
# ------------------------------------------------------------------------------
# Standard MongoDB Atlas SRV connection string with credentials.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://deployx_app_user:REPLACE_WITH_SECURE_PASSWORD@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Target database name within the Atlas cluster.
# DeployX strictly isolates its documents in 'deployx_db'.
MONGODB_DB=deployx_db

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security (Private Server-Only)
# ------------------------------------------------------------------------------
# High-entropy secret key used for signing HS256 JWT session tokens.
# Must be at least 32 characters in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_HEX_SECRET_GENERATE_WITH_OPENSSL

# ------------------------------------------------------------------------------
# 4. GitHub OAuth Application Integration (Private Server-Only)
# ------------------------------------------------------------------------------
# Created at: https://github.com/settings/developers -> OAuth Apps
# Homepage URL:            https://deployx.yourdomain.com
# Authorization Callback:  https://deployx.yourdomain.com/api/integrations/github/callback
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET

# Optional callback URL override.
# Defaults automatically to: ${NEXT_PUBLIC_APP_URL}/api/integrations/github/callback
GITHUB_CALLBACK_URL=

# Optional 32-byte (64 hex characters) key for AES-256-GCM token encryption at rest.
# If left empty, DeployX cryptographically derives an encryption key from JWT_SECRET.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudflare Pages Deployment Provider (Private Server-Only)
# ------------------------------------------------------------------------------
# 32-character hexadecimal Account ID from Cloudflare Dashboard (Overview / Workers & Pages).
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# Scoped API Token created at https://dash.cloudflare.com/profile/api-tokens
# Minimum permissions required: Account -> Cloudflare Pages -> Edit
CLOUDFLARE_API_TOKEN=REPLACE_WITH_SCOPED_CLOUDFLARE_API_TOKEN
