# AI Assistant
AI_API_KEY=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# MongoDB Authentication
MONGODB_URI="mongodb+srv://..."
JWT_SECRET="your-jwt-secret"

CLOUDFLARE_API_TOKEN=
